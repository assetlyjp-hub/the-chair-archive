---
// ChairModalEn.astro - 英語版の椅子詳細モーダル
// 日本語版(ChairModal.astro)と同じ構造で、テキストだけ英語に
// クリックで開き、ESCキー / 背景クリック / 閉じるボタンで閉じる

// 全椅子データを読み込む（モーダル内で関連椅子も表示するため）
import chairsData from '../data/chairs.json';

// 価格のフォーマット（英語版ではドル表記ではなく円のまま）
function formatPrice(price: number): string {
  return `\u00a5${price.toLocaleString()}`;
}
---

<!-- モーダルのオーバーレイ（背景） -->
<div class="modal-overlay" id="chair-modal">
  <!-- モーダル本体 -->
  <div class="modal" role="dialog" aria-modal="true">
    <!-- 閉じるボタン -->
    <button class="modal__close" id="modal-close" aria-label="Close">
      &times;
    </button>

    <!-- モーダルの中身（JavaScriptで動的に埋める） -->
    <div class="modal__content" id="modal-content">
      <!-- ここにJSで椅子情報が入る -->
    </div>
  </div>
</div>

<!-- モーダルの開閉を制御するJavaScript -->
<script define:vars={{ chairsData }}>
  // 全椅子データをグローバルに保持
  const allChairs = chairsData;

  // DOM要素の取得
  const modalOverlay = document.getElementById('chair-modal');
  const modalContent = document.getElementById('modal-content');
  const modalClose = document.getElementById('modal-close');

  // 価格をフォーマットする関数
  function formatPrice(price) {
    return `\u00a5${price.toLocaleString()}`;
  }

  // モーダルを開く関数（英語版: descriptionEn / featuresEn を使用）
  function openModal(chairId) {
    // 対応する椅子データを検索
    const chair = allChairs.find(c => c.id === chairId);
    if (!chair) return;

    // 関連する椅子を取得
    const relatedChairs = chair.relatedChairs
      .map(id => allChairs.find(c => c.id === id))
      .filter(Boolean);

    // 英語の説明文とフィーチャーを使用（フォールバックで日本語）
    const description = chair.descriptionEn || chair.description;
    const features = chair.featuresEn || chair.features;

    // モーダルの中身をHTMLで生成
    modalContent.innerHTML = `
      <!-- 椅子の画像 -->
      <img
        src="${chair.image}"
        alt="${chair.name}"
        class="modal__image"
        onerror="this.onerror=null; this.src='/images/chairs/placeholder.svg';"
      />

      <!-- 椅子名（英語版なので name を大きく表示） -->
      <h2 class="modal__title">${chair.name}</h2>
      <p class="modal__subtitle">${chair.designer} / ${chair.year}</p>

      <!-- 英語の説明文 -->
      <p class="modal__description">${description}</p>

      <!-- スペック表 -->
      <div class="modal__specs">
        <div class="modal__spec-item">
          <span class="modal__spec-label">Width</span>
          <span class="modal__spec-value">${chair.dimensions.width} cm</span>
        </div>
        <div class="modal__spec-item">
          <span class="modal__spec-label">Depth</span>
          <span class="modal__spec-value">${chair.dimensions.depth} cm</span>
        </div>
        <div class="modal__spec-item">
          <span class="modal__spec-label">Height</span>
          <span class="modal__spec-value">${chair.dimensions.height} cm</span>
        </div>
        <div class="modal__spec-item">
          <span class="modal__spec-label">Seat Height</span>
          <span class="modal__spec-value">${chair.dimensions.seatHeight} cm</span>
        </div>
        <div class="modal__spec-item">
          <span class="modal__spec-label">Weight</span>
          <span class="modal__spec-value">${chair.weight} kg</span>
        </div>
        <div class="modal__spec-item">
          <span class="modal__spec-label">Materials</span>
          <span class="modal__spec-value">${chair.materials.join(', ')}</span>
        </div>
        <div class="modal__spec-item">
          <span class="modal__spec-label">Style</span>
          <span class="modal__spec-value">${chair.style}</span>
        </div>
        <div class="modal__spec-item">
          <span class="modal__spec-label">Country</span>
          <span class="modal__spec-value">${chair.country}</span>
        </div>
      </div>

      <!-- 価格情報（英語版ラベル） -->
      <div style="margin-bottom: var(--space-lg);">
        <p style="font-size: 0.75rem; color: var(--color-muted); margin-bottom: var(--space-xs); font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.1em;">Price Range</p>
        <p style="font-size: 1.1rem; font-family: var(--font-display);">
          Authentic: ${formatPrice(chair.priceRange.authentic)}
          ${chair.priceRange.replica ? ` / Replica: ${formatPrice(chair.priceRange.replica)}` : ''}
        </p>
      </div>

      <!-- 特徴リスト（英語版） -->
      <div style="margin-bottom: var(--space-lg);">
        <p style="font-size: 0.75rem; color: var(--color-muted); margin-bottom: var(--space-sm); font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.1em;">Features</p>
        <ul style="display: flex; flex-wrap: wrap; gap: var(--space-xs);">
          ${features.map(f => `
            <li style="font-size: 0.8rem; padding: 0.3rem 0.8rem; border: 1px solid var(--color-border); font-family: var(--font-body);">${f}</li>
          `).join('')}
        </ul>
      </div>

      <!-- 購入リンク（英語版ラベル） -->
      <div class="modal__buy-links">
        ${chair.affiliateUrls.amazon ? `<a href="${chair.affiliateUrls.amazon}" target="_blank" rel="nofollow noopener" class="btn btn--filled">View on Amazon</a>` : '<span class="btn btn--filled" style="opacity:0.4; cursor:default;">Amazon (Coming Soon)</span>'}
        ${chair.affiliateUrls.rakuten ? `<a href="${chair.affiliateUrls.rakuten}" target="_blank" rel="nofollow noopener" class="btn">View on Rakuten</a>` : '<span class="btn" style="opacity:0.4; cursor:default;">Rakuten (Coming Soon)</span>'}
        ${chair.affiliateUrls.official ? `<a href="${chair.affiliateUrls.official}" target="_blank" rel="noopener" class="btn">Official Site</a>` : '<span class="btn" style="opacity:0.4; cursor:default;">Official Site (Coming Soon)</span>'}
      </div>

      <!-- 関連する椅子 -->
      ${relatedChairs.length > 0 ? `
        <div class="modal__related">
          <h3 class="modal__related-title">Related Chairs</h3>
          <div class="modal__related-grid">
            ${relatedChairs.map(rc => `
              <div class="chair-card-wrapper" data-chair-id="${rc.id}" onclick="openModal('${rc.id}')">
                <div class="chair-card chair-card--small" style="aspect-ratio: 1/1;">
                  <img src="${rc.image}" alt="${rc.name}" class="chair-card__image" loading="lazy" onerror="this.onerror=null; this.src='/images/chairs/placeholder.svg';" />
                  <div class="chair-card__info">
                    <p class="chair-card__name" style="font-size: 0.85rem;">${rc.name}</p>
                    <p class="chair-card__designer" style="font-size: 0.65rem;">${rc.designer}</p>
                  </div>
                </div>
              </div>
            `).join('')}
          </div>
        </div>
      ` : ''}
    `;

    // モーダルを表示
    modalOverlay.classList.add('is-open');
    document.body.classList.add('modal-open');

    // モーダルの先頭にスクロール
    modalOverlay.querySelector('.modal').scrollTop = 0;
  }

  // モーダルを閉じる関数
  function closeModal() {
    modalOverlay.classList.remove('is-open');
    document.body.classList.remove('modal-open');
  }

  // 閉じるボタンのクリック
  modalClose.addEventListener('click', closeModal);

  // 背景クリックで閉じる
  modalOverlay.addEventListener('click', (e) => {
    if (e.target === modalOverlay) {
      closeModal();
    }
  });

  // ESCキーで閉じる
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modalOverlay.classList.contains('is-open')) {
      closeModal();
    }
  });

  // 全てのカードにクリックイベントを設定
  document.querySelectorAll('.chair-card-wrapper[data-chair-id]').forEach(card => {
    card.addEventListener('click', (e) => {
      // 関連椅子カード内のクリックは別処理（onclick属性）で対応済みなのでスキップ
      if (card.closest('.modal__related-grid')) return;

      const chairId = card.getAttribute('data-chair-id');
      if (chairId) openModal(chairId);
    });
  });

  // openModalをグローバルに公開（関連椅子カードから呼び出すため）
  window.openModal = openModal;
</script>
