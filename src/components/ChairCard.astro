---
// ChairCard.astro - 椅子カードコンポーネント
// ホバーすると「本めくり」のように右端がめくれて、価格がチラ見えする演出

interface Props {
  chair: {
    id: string;
    name: string;
    nameJa: string;
    designer: string;
    year: number;
    style: string;
    priceRange: { authentic: number; replica: number };
    image: string;
  };
  size?: 'small';  // 関連椅子で使う小サイズ用（オプション）
}

const { chair, size } = Astro.props;

// 価格をフォーマット（例: 48400 → ¥48,400）undefinedでも落とさない
function formatPrice(price: number | undefined | null): string {
  if (typeof price !== 'number') return '—';
  return `¥${price.toLocaleString()}`;
}

// priceRange はオブジェクト（旧形式）と文字列ラベル（新形式）の両方に対応
const cardPrice: number | undefined =
  (typeof chair.priceRange === 'object' && chair.priceRange !== null)
    ? chair.priceRange.authentic
    : chair.price;
---

<!-- カードのラッパー -->
<div
  class="chair-card-wrapper"
  data-chair-id={chair.id}
  data-style={chair.style}
  data-price={cardPrice}
>
  <div class={`chair-card${size === 'small' ? ' chair-card--small' : ''}`}>
    <!-- 椅子画像 -->
    <img
      src={chair.image}
      alt={`${chair.name} - ${chair.designer}, ${chair.year}`}
      class="chair-card__image"
      loading="lazy"
      onerror="this.onerror=null; this.src='/images/chairs/placeholder.svg';"
    />

    <!-- カード下部の情報オーバーレイ -->
    <div class="chair-card__info">
      <p class="chair-card__name">{chair.name}</p>
      <p class="chair-card__designer">{chair.designer}, {chair.year}</p>
    </div>

    <!-- めくれた裏側にチラ見えする価格情報 -->
    <div class="chair-card__back">
      <span>{formatPrice(cardPrice)}</span>
    </div>
  </div>
</div>
