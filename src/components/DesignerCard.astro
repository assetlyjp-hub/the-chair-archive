---
// DesignerCard.astro - デザイナーカード
// デザイナー一覧ページで使用

interface Props {
  designer: {
    id: string;
    name: string;
    nameJa: string;
    born: string;
    died: string;
    country: string;
    style: string;
  };
}

const { designer } = Astro.props;
---

<a href={`/designers/${designer.id}/`} class="designer-card">
  <h3 class="designer-card__name">{designer.name}</h3>
  <p class="designer-card__name-ja">{designer.nameJa}</p>
  <p class="designer-card__meta">
    {designer.born} – {designer.died} / {designer.country}
  </p>
</a>
