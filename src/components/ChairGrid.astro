---
// ChairGrid.astro - 均等サイズのグリッドレイアウト

import ChairCard from './ChairCard.astro';

interface Chair {
  id: string;
  name: string;
  nameJa: string;
  designer: string;
  year: number;
  style: string;
  priceRange: { authentic: number; replica: number };
  image: string;
}

interface Props {
  chairs: Chair[];
}

const { chairs } = Astro.props;
---

<div class="chair-grid" id="chair-grid">
  {chairs.map((chair) => (
    <ChairCard chair={chair} />
  ))}
</div>
