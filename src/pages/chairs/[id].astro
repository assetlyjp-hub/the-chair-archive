---
// chairs/[id].astro - 椅子詳細ページ（日本語版）
// 動的ルーティングで各椅子の詳細情報を表示
// SEO: Article JSON-LD でリッチスニペット対応

import Base from '../../layouts/Base.astro';
import ChairCard from '../../components/ChairCard.astro';

// データの読み込み
import chairsData from '../../data/chairs.json';
import designersData from '../../data/designers.json';

// 静的パス生成（全椅子のIDからパスを生成）
export function getStaticPaths() {
  return chairsData.map((chair) => ({
    params: { id: chair.id },
  }));
}

// URLパラメータから椅子IDを取得
const { id } = Astro.params;

// 該当する椅子データを検索
const chair = chairsData.find(c => c.id === id);
if (!chair) return Astro.redirect('/404');

// デザイナーデータを検索
const designer = designersData.find(d => d.id === chair.designerId);

// 関連椅子データを取得
const relatedChairs = chair.relatedChairs
  .map(relId => chairsData.find(c => c.id === relId))
  .filter(Boolean);

// 価格フォーマット
function formatPrice(price: number): string {
  return `¥${price.toLocaleString()}`;
}

// JSON-LD構造化データ（Article schema）
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": chair.name,
  "description": chair.description,
  "image": new URL(chair.image, Astro.site).href,
  "author": {
    "@type": "Organization",
    "name": "The Chair Archive",
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Chair Archive",
  },
  "datePublished": new Date().toISOString().split('T')[0],
};
---

<Base
  title={`${chair.nameJa}（${chair.name}）`}
  description={chair.description.slice(0, 160)}
  ogImage={chair.image}
  enPath={`/en/chairs/${chair.id}/`}
  jsonLd={articleJsonLd}
>
  <!-- 一覧への戻りリンク -->
  <div class="container" style="padding-top: calc(var(--space-md) + 60px);">
    <a href="/" style="font-size: 0.85rem; color: var(--color-muted); text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem; transition: color 0.2s;">
      <span>&larr;</span> Archive に戻る
    </a>
  </div>

  <!-- 椅子詳細ヘッダー -->
  <div class="page-header" style="padding-top: var(--space-sm);">
    <p style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); margin-bottom: 0.5rem; font-family: var(--font-display);">
      {chair.style.charAt(0).toUpperCase() + chair.style.slice(1)} · {chair.year}
    </p>
    <h1 class="page-header__title" style="font-family: var(--font-display);">{chair.name}</h1>
    <p class="page-header__description" style="font-family: var(--font-body);">
      {chair.nameJa} / {chair.designerJa}
    </p>
  </div>

  <div class="container section" style="max-width: var(--container-narrow); margin: 0 auto;">
    <!-- 椅子画像 -->
    <div style="text-align: center; margin-bottom: var(--space-lg);">
      <img
        src={chair.image}
        alt={chair.name}
        style="max-width: 100%; max-height: 500px; object-fit: contain;"
        onerror="this.onerror=null; this.src='/images/chairs/placeholder.svg';"
      />
      {/* LC4 Chaise Longue の写真クレジット（CC BY-SA 3.0） */}
      {chair.id === 'lc4-chaise-longue' && (
        <p style="font-size: 0.7rem; color: var(--color-muted); margin-top: 0.5rem;">
          Photo:
          <a href="https://commons.wikimedia.org/wiki/File:LC4,_chaise_longue.png" target="_blank" rel="noopener" style="color: var(--color-muted);">Wikimedia Commons</a> /
          <a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener" style="color: var(--color-muted);">CC BY-SA 3.0</a>
        </p>
      )}
    </div>

    <!-- 説明文 -->
    <div style="margin-bottom: var(--space-lg); line-height: 2; font-size: 0.95rem;">
      <p>{chair.description}</p>
    </div>

    <!-- スペック -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: var(--space-sm); margin-bottom: var(--space-lg); padding: var(--space-md); border: 1px solid var(--color-border);">
      <div>
        <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-muted); font-family: var(--font-display); margin-bottom: 0.3rem;">Width</p>
        <p style="font-size: 0.9rem;">{chair.dimensions.width} cm</p>
      </div>
      <div>
        <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-muted); font-family: var(--font-display); margin-bottom: 0.3rem;">Depth</p>
        <p style="font-size: 0.9rem;">{chair.dimensions.depth} cm</p>
      </div>
      <div>
        <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-muted); font-family: var(--font-display); margin-bottom: 0.3rem;">Height</p>
        <p style="font-size: 0.9rem;">{chair.dimensions.height} cm</p>
      </div>
      <div>
        <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-muted); font-family: var(--font-display); margin-bottom: 0.3rem;">Seat Height</p>
        <p style="font-size: 0.9rem;">{chair.dimensions.seatHeight} cm</p>
      </div>
      <div>
        <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-muted); font-family: var(--font-display); margin-bottom: 0.3rem;">Weight</p>
        <p style="font-size: 0.9rem;">{chair.weight} kg</p>
      </div>
      <div>
        <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-muted); font-family: var(--font-display); margin-bottom: 0.3rem;">Materials</p>
        <p style="font-size: 0.9rem;">{chair.materials.join('、')}</p>
      </div>
      <div>
        <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-muted); font-family: var(--font-display); margin-bottom: 0.3rem;">Colors</p>
        <p style="font-size: 0.9rem;">{chair.colors.join('、')}</p>
      </div>
      <div>
        <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-muted); font-family: var(--font-display); margin-bottom: 0.3rem;">Country</p>
        <p style="font-size: 0.9rem;">{chair.country}</p>
      </div>
    </div>

    <!-- 価格情報 -->
    <div style="margin-bottom: var(--space-lg); padding: var(--space-md); border: 1px solid var(--color-border);">
      <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-muted); font-family: var(--font-display); margin-bottom: var(--space-sm);">Price Range</p>
      <p style="font-size: 1.1rem; font-family: var(--font-display);">
        正規品: {formatPrice(chair.priceRange.authentic)}
        {chair.priceRange.replica && ` / リプロダクト: ${formatPrice(chair.priceRange.replica)}`}
      </p>
    </div>

    <!-- 特徴リスト -->
    <div style="margin-bottom: var(--space-lg);">
      <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-muted); font-family: var(--font-display); margin-bottom: var(--space-sm);">Features</p>
      <ul style="display: flex; flex-wrap: wrap; gap: var(--space-xs); list-style: none;">
        {chair.features.map((f: string) => (
          <li style="font-size: 0.8rem; padding: 0.3rem 0.8rem; border: 1px solid var(--color-border);">{f}</li>
        ))}
      </ul>
    </div>

    <!-- 購入リンク -->
    <div style="display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-bottom: var(--space-xl);">
      {chair.affiliateUrls.amazonJP ? (
        <a href={chair.affiliateUrls.amazonJP} target="_blank" rel="nofollow noopener" class="btn btn--filled">Amazon JP で見る</a>
      ) : (
        <span class="btn btn--filled" style="opacity:0.4; cursor:default;">Amazon JP（準備中）</span>
      )}
      {chair.affiliateUrls.amazonUK ? (
        <a href={chair.affiliateUrls.amazonUK} target="_blank" rel="nofollow noopener" class="btn btn--filled">Amazon UK で見る</a>
      ) : (
        <span class="btn btn--filled" style="opacity:0.4; cursor:default;">Amazon UK（準備中）</span>
      )}
      {chair.affiliateUrls.rakuten ? (
        <a href={chair.affiliateUrls.rakuten} target="_blank" rel="nofollow noopener" class="btn">楽天市場 で見る</a>
      ) : (
        <span class="btn" style="opacity:0.4; cursor:default;">楽天市場（準備中）</span>
      )}
      {chair.affiliateUrls.official ? (
        <a href={chair.affiliateUrls.official} target="_blank" rel="noopener" class="btn">公式サイト</a>
      ) : (
        <span class="btn" style="opacity:0.4; cursor:default;">公式サイト（準備中）</span>
      )}
    </div>

    <!-- デザイナー情報 -->
    {designer && (
      <div style="border-top: 1px solid var(--color-border); padding-top: var(--space-lg); margin-bottom: var(--space-lg);">
        <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-muted); font-family: var(--font-display); margin-bottom: var(--space-sm);">Designer</p>
        <h2 style="font-family: var(--font-display); font-size: 1.5rem; margin-bottom: var(--space-xs);">
          <a href={`/designers/${designer.id}/`} style="color: var(--color-text); text-decoration: none;">
            {designer.name}
          </a>
        </h2>
        <p style="font-size: 0.85rem; color: var(--color-muted); margin-bottom: var(--space-sm);">{designer.nameJa}</p>
        <p style="font-size: 0.9rem; line-height: 1.8;">{designer.bio.slice(0, 200)}…
          <a href={`/designers/${designer.id}/`} style="color: var(--color-accent);">もっと読む</a>
        </p>
      </div>
    )}

    <!-- 関連する椅子 -->
    {relatedChairs.length > 0 && (
      <div style="border-top: 1px solid var(--color-border); padding-top: var(--space-lg);">
        <h2 style="font-family: var(--font-display); font-size: 1.5rem; margin-bottom: var(--space-lg); text-align: center;">Related Chairs</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: var(--space-md);">
          {relatedChairs.map(rc => (
            <a href={`/chairs/${rc.id}/`} style="text-decoration: none; color: inherit;">
              <ChairCard chair={rc} size="small" />
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Base>
