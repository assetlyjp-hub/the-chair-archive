---
// index.astro - トップページ
// ヒーローセクション + フィルター + 大小混合グリッドで椅子を一覧表示

import Base from '../layouts/Base.astro';
import FilterBar from '../components/FilterBar.astro';
import ChairGrid from '../components/ChairGrid.astro';
import ChairModal from '../components/ChairModal.astro';

// 椅子データの読み込み
import chairsData from '../data/chairs.json';

// ItemList JSON-LD: Google検索結果でカルーセル表示の可能性を高める
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Iconic Designer Chairs",
  "numberOfItems": chairsData.length,
  "itemListElement": chairsData.map((chair, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": `https://thechairarchive.com/chairs/${chair.id}/`,
    "name": chair.name,
  })),
};
---

<Base title="The Chair Archive" jsonLd={itemListJsonLd}>
  <!-- ヒーローセクション: 大きなタイポグラフィ -->
  <section class="hero">
    <h1 class="hero__title">The Chair Archive</h1>
    <p class="hero__subtitle">名作椅子のすべてを、ここに。</p>
  </section>

  <!-- メインコンテンツ -->
  <div class="container">
    <!-- フィルターバー -->
    <FilterBar />

    <!-- 大小混合グリッド -->
    <ChairGrid chairs={chairsData} />
  </div>

  <!-- 椅子詳細モーダル -->
  <ChairModal />
</Base>
