---
// BaseEn.astro - 英語版ページの共通レイアウト
// 日本語版(Base.astro)と同じデザインで、テキストだけ英語に
// ヘッダーに言語切り替えリンクを追加

// ページごとに渡されるプロパティ（各英語ページから受け取る）
interface Props {
  title: string;          // ページタイトル
  description?: string;   // メタディスクリプション
  ogImage?: string;       // OGP画像のURL
  type?: string;          // ページタイプ（website / article）
  jaPath?: string;        // 日本語版ページのパス（hreflang用）
  jsonLd?: object;        // 追加のJSON-LD構造化データ
}

const {
  title,
  description = 'Everything about iconic chairs. A database of masterpiece chairs that shaped design history.',
  ogImage = '/images/og-default.jpg',
  type = 'website',
  jaPath = '/',           // デフォルトはトップページ
  jsonLd,
} = Astro.props;

// ページのフルタイトル
const fullTitle = title === 'The Chair Archive'
  ? title
  : `${title} | The Chair Archive`;

// 現在のURL
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// 日本語版ページのURL（hreflang用）
const jaURL = new URL(jaPath, Astro.site);

// 英語版ページのURL（hreflang用）
const enURL = canonicalURL;

// グローバルCSS（日本語版と同じスタイルを使用）
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <!-- SEO メタタグ -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- hreflang タグ: Googleに日英ページの関係を伝える -->
  <link rel="alternate" hreflang="ja" href={jaURL} />
  <link rel="alternate" hreflang="en" href={enURL} />
  <link rel="alternate" hreflang="x-default" href={jaURL} />

  <!-- OGP（SNSシェア用） -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="The Chair Archive" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Google Fonts: 日本語版と同じフォントを使用 -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Shippori+Mincho:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <!-- ファビコン -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- JSON-LD 構造化データ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "The Chair Archive",
    "url": "https://thechairarchive.com/en/",
    "description": description,
    "inLanguage": "en",
    "publisher": {
      "@type": "Organization",
      "name": "Ichirin LLC",
      "email": "info@thechairarchive.com"
    }
  })} />

  <!-- 追加のJSON-LD（ページ固有の構造化データ） -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
</head>

<body>
  <!-- ヘッダー: 日本語版と同じデザイン + 言語切り替えリンク -->
  <header class="site-header">
    <div class="site-header__inner">
      <a href="/en/" class="site-header__logo">The Chair Archive</a>

      <nav class="site-header__nav" id="main-nav">
        <a href="/en/">Archive</a>
        <a href="/en/designers/">Designers</a>
        <a href="/magazine/">Magazine</a>
        <a href="/compare/">Compare</a>
        <a href="/about/">About</a>
        <!-- 言語切り替えリンク（日本語版へ） -->
        <a href={jaPath} class="lang-switch" title="日本語">JA</a>
      </nav>

      <!-- モバイルメニューボタン -->
      <button class="site-header__menu-toggle" id="menu-toggle" aria-label="Open menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <!-- モバイルメニュー用オーバーレイ -->
  <div class="menu-overlay" id="menu-overlay"></div>

  <!-- メインコンテンツ（各ページが差し込まれる） -->
  <main>
    <slot />
  </main>

  <!-- フッター -->
  <footer class="site-footer">
    <div class="site-footer__inner">
      <p class="site-footer__logo">The Chair Archive</p>
      <div class="site-footer__links">
        <a href="/about/">About</a>
        <a href="/privacy/">Privacy</a>
      </div>
      <!-- Archive Series links -->
      <p class="site-footer__series" style="font-size: 0.7rem; color: var(--color-muted); margin-bottom: var(--space-sm); letter-spacing: 0.03em;">
        Archive Series:
        <a href="https://japaneseknifearchive.com" target="_blank" rel="noopener noreferrer" style="color: var(--color-muted);">Knives</a> &middot;
        <a href="https://thepenarchive.com" target="_blank" rel="noopener noreferrer" style="color: var(--color-muted);">Pens</a> &middot;
        <a href="https://coffeegeararchive.com" target="_blank" rel="noopener noreferrer" style="color: var(--color-muted);">Coffee</a> &middot;
        <a href="https://bootcraftarchive.com" target="_blank" rel="noopener noreferrer" style="color: var(--color-muted);">Boots</a> &middot;
        <strong>Chairs</strong>
      </p>
      <p class="site-footer__text">&copy; {new Date().getFullYear()} Ichirin LLC. All rights reserved.</p>
    </div>
  </footer>

  <!-- モバイルメニューの開閉スクリプト -->
  <script>
    const menuToggle = document.getElementById('menu-toggle');
    const mainNav = document.getElementById('main-nav');
    const menuOverlay = document.getElementById('menu-overlay');

    function toggleMenu() {
      const isOpen = mainNav?.classList.toggle('is-open');
      menuToggle?.classList.toggle('is-open', isOpen);
      menuOverlay?.classList.toggle('is-open', isOpen);
      document.body.classList.toggle('menu-open', isOpen);
    }

    function closeMenu() {
      mainNav?.classList.remove('is-open');
      menuToggle?.classList.remove('is-open');
      menuOverlay?.classList.remove('is-open');
      document.body.classList.remove('menu-open');
    }

    menuToggle?.addEventListener('click', toggleMenu);
    menuOverlay?.addEventListener('click', closeMenu);

    mainNav?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });
  </script>
</body>
</html>
